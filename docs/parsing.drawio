<mxCell id="jbc78" value="&lt;b&gt;chunks&lt;/b&gt;: chat passages (text), all divisions.&lt;br&gt;&lt;b&gt;chunks_archive&lt;/b&gt;, &lt;b&gt;archive_notices&lt;/b&gt;: old documents (impact search only).&lt;br&gt;&lt;b&gt;image_metadata&lt;/b&gt;: new images as PENDING.&lt;br&gt;&lt;b&gt;parsed_documents&lt;/b&gt;: status per IDDOC · &lt;b&gt;parsing_run_health&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="jbc77"><mxGeometry x="0" y="30" width="380" height="103" as="geometry"/></mxCell>
