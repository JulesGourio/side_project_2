<mxCell id="jbc40" value="Category path and division of each IDDOC." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="jbc39"><mxGeometry x="0" y="30" width="380" height="35" as="geometry"/></mxCell>
<mxCell id="jbe41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;strokeColor=#78909C;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.328;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="jbc34" target="jbc39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="jbe42" value="04:00" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#37474F;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="jbc5" target="jbc34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="jbc43" value="2_manifest&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#2F6DB5&quot;&gt;CPU · meta_cpu_cluster&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#DCE8F7;strokeColor=#2F6DB5;swimlaneFillColor=#FFFFFF;fontColor=#16324F;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="450" y="559" width="580" height="150" as="geometry"/></mxCell>
<mxCell id="jbc44" value="&lt;b&gt;Scope gate&lt;/b&gt;: current revision, validated, visible, in one of the scope root categories.&lt;br&gt;Manual exclusions (categories, REFs).&lt;br&gt;&lt;b&gt;Scope guard&lt;/b&gt;: fails and deletes nothing if the scope shrank by more than &lt;b&gt;30 %&lt;/b&gt;.&lt;br&gt;&lt;b&gt;Pruning&lt;/b&gt;: rows of every IDDOC that left the scope (superseded revision, removed) are deleted.&lt;br&gt;Volume folders classified: KEEP, DELETE, ORPHAN, SKIP." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="jbc43"><mxGeometry x="0" y="30" width="580" height="120" as="geometry"/></mxCell>
<mxCell id="jbc45" value="Intraqual data asset + volume listing" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F0E6D8;strokeColor=#8D6E63;swimlaneFillColor=#FFFFFF;fontColor=#3E2723;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="559" width="330" height="99" as="geometry"/></mxCell>
<mxCell id="jbc46" value="Same tables as 1_categories, &lt;b&gt;category_reference&lt;/b&gt;, and the list of the folders &lt;b&gt;D_&amp;lt;IDDOC&amp;gt;&lt;/b&gt; on the source volume." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="jbc45"><mxGeometry x="0" y="30" width="330" height="69" as="geometry"/></mxCell>
<mxCell id="jbe47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;strokeColor=#2E7D32;dashed=1;dashPattern=2 3;endArrow=open;endFill=0;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.33;entryDx=0;entryDy=0;" edge="1" parent="1" source="jbc45" target="jbc43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="jbc48" value="parse_manifest · pruning" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#E4E9EC;strokeColor=#607D8B;swimlaneFillColor=#FFFFFF;fontColor=#1F2D33;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;dashed=0;" vertex="1" parent="1"><mxGeometry x="1090" y="559" width="380" height="133" as="geometry"/></mxCell>
<mxCell id="jbc49" value="&lt;b&gt;parse_manifest&lt;/b&gt;: the in-scope documents of the day (REF, title, revision, date, categories).&lt;br&gt;&lt;b&gt;parsed_documents&lt;/b&gt;: skip rows.&lt;br&gt;Deletes out-of-scope rows in &lt;b&gt;chunks&lt;/b&gt;, &lt;b&gt;chunks_archive&lt;/b&gt;, &lt;b&gt;image_metadata&lt;/b&gt;, &lt;b&gt;parsed_documents&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="jbc48"><mxGeometry x="0" y="30" width="380" height="103" as="geometry"/></mxCell>
<mxCell id="jbe50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;strokeColor=#78909C;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.443;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="jbc43" target="jbc48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="jbe51" value="sources fresh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#37474F;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="jbc34" target="jbc43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="jbc52" value="3_parse&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#2F6DB5&quot;&gt;CPU · parse_cpu_cluster&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#DCE8F7;strokeColor=#2F6DB5;swimlaneFillColor=#FFFFFF;fontColor=#16324F;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="450" y="789" width="580" height="201" as="geometry"/></mxCell>
<mxCell id="jbc53" value="&lt;b&gt;File choice&lt;/b&gt; per IDDOC: docx › pdf › docm › doc › html › pptx … (format priority, then newest).&lt;br&gt;&lt;b&gt;Resume&lt;/b&gt;: a file already parsed with the same SHA-256 is skipped.&lt;br&gt;&lt;b&gt;Parsers&lt;/b&gt;: Docling (docx, pptx, html, few PDFs) · antiword, striprtf, odfpy, xlrd, openpyxl, pyxlsb.&lt;br&gt;Size ceilings 15 / 35 / 100 MB · ≤ &lt;b&gt;500&lt;/b&gt; files per run · checkpoint every 100 files.&lt;br&gt;&lt;b&gt;Images&lt;/b&gt; extracted as PNG (×3 scale); decorative ones (small, repeated) set aside.&lt;br&gt;Scanned PDF (text ≤ 150 chars): pages rendered for the vision model (≤ 100 pages).&lt;br&gt;&lt;b&gt;More than 30 PDFs left&lt;/b&gt; → queued for the GPU task." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="jbc52"><mxGeometry x="0" y="30" width="580" height="171" as="geometry"/></mxCell>
<mxCell id="jbc54" value="Source files + models" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#E4E9EC;strokeColor=#607D8B;swimlaneFillColor=#FFFFFF;fontColor=#1F2D33;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="789" width="330" height="82" as="geometry"/></mxCell>
<mxCell id="jbc55" value="Intraqual volume: one folder per IDDOC.&lt;br&gt;&lt;b&gt;docling_models&lt;/b&gt; volume: offline Docling models." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="jbc54"><mxGeometry x="0" y="30" width="330" height="52" as="geometry"/></mxCell>
