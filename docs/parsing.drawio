<mxCell id="jbc34" value="1_categories&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#2F6DB5&quot;&gt;CPU · meta_cpu_cluster&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#DCE8F7;strokeColor=#2F6DB5;swimlaneFillColor=#FFFFFF;fontColor=#16324F;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="450" y="380" width="580" height="99" as="geometry"/></mxCell>
<mxCell id="jbc35" value="&lt;b&gt;Freshness guard&lt;/b&gt;: fails the run if a source table is older than &lt;b&gt;36 h&lt;/b&gt;.&lt;br&gt;Category tree of each IDDOC and its &lt;b&gt;division&lt;/b&gt;: AS, IS or GROUP (shared by both).&lt;br&gt;A revision without category takes the one of its closest earlier revision." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="jbc34"><mxGeometry x="0" y="30" width="580" height="69" as="geometry"/></mxCell>
<mxCell id="jbc36" value="Intraqual data asset" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F0E6D8;strokeColor=#8D6E63;swimlaneFillColor=#FFFFFF;fontColor=#3E2723;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="330" height="99" as="geometry"/></mxCell>
<mxCell id="jbc37" value="&lt;b&gt;document_revisions_intraqual&lt;/b&gt;: one row per IDDOC (one IDDOC per revision), categories.&lt;br&gt;Refreshed upstream during the day." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="jbc36"><mxGeometry x="0" y="30" width="330" height="69" as="geometry"/></mxCell>
