<diagram name="3 · Document rules" id="dr"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="948" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="drb8" value="STATUS OF A DOCUMENT (parsed_documents.parse_status)" style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#F6F7F8;strokeColor=#D5DBE0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#607D8B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="368" width="1480" height="520" as="geometry"/></mxCell>
<mxCell id="drc1" value="&lt;b style=&quot;font-size:24px&quot;&gt;Which documents get in, and what happens to each one&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#546E7A&quot;&gt;Scope, revisions and the status of a document in parsed_documents.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#16324F;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="60" as="geometry"/></mxCell>
<mxCell id="drc2" value="Scope gate (2_manifest)" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#DCE8F7;strokeColor=#2F6DB5;swimlaneFillColor=#FFFFFF;fontColor=#16324F;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="440" height="218" as="geometry"/></mxCell>
<mxCell id="drc3" value="On &lt;b&gt;document_revisions_intraqual&lt;/b&gt;:&lt;br&gt;• current revision (&lt;b&gt;courant = 1&lt;/b&gt;)&lt;br&gt;• validated (&lt;b&gt;etat = 7&lt;/b&gt;)&lt;br&gt;• visible (&lt;b&gt;nonvisible = 0&lt;/b&gt;)&lt;br&gt;• root category in the scope list (One QMS processes, AS programmes, AS work instructions, AS processes, group directives) or a &quot;To be classified&quot; sub-folder&lt;br&gt;• not in the manual exclusions (categories, REFs).&lt;br&gt;&lt;b&gt;difftotale&lt;/b&gt; is not part of the gate: the portal shows documents with difftotale = 0." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="drc2"><mxGeometry x="0" y="30" width="440" height="188" as="geometry"/></mxCell>
<mxCell id="drc4" value="One revision = one IDDOC" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#DCE8F7;strokeColor=#2F6DB5;swimlaneFillColor=#FFFFFF;fontColor=#16324F;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="540" y="110" width="440" height="201" as="geometry"/></mxCell>
<mxCell id="drc5" value="Each Intraqual revision gets a &lt;b&gt;new IDDOC&lt;/b&gt;; the old one is never updated in place.&lt;br&gt;Example: REF QR-1005 has 70 IDDOCs, only the latest is current.&lt;br&gt;So a revision shows up as: the old IDDOC &lt;b&gt;leaves the scope&lt;/b&gt;, the new one &lt;b&gt;enters&lt;/b&gt;.&lt;br&gt;2_manifest then deletes the old IDDOC&#x27;s passages and images; the new one is parsed.&lt;br&gt;Several in-scope IDDOCs for one REF: only the newest revision keeps its passages." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="drc4"><mxGeometry x="0" y="30" width="440" height="171" as="geometry"/></mxCell>
<mxCell id="drc6" value="Archive routing" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#DCE8F7;strokeColor=#2F6DB5;swimlaneFillColor=#FFFFFF;fontColor=#16324F;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="1040" y="110" width="440" height="150" as="geometry"/></mxCell>
<mxCell id="drc7" value="Published before &lt;b&gt;2016-01-01&lt;/b&gt; and outside the exempt categories → passages go to &lt;b&gt;chunks_archive&lt;/b&gt;, never to &lt;b&gt;chunks&lt;/b&gt;.&lt;br&gt;Every scope root is exempt: &lt;b&gt;no in-scope document is archived today&lt;/b&gt;.&lt;br&gt;Archives feed the impact search only (decided 2026-10-22).&lt;br&gt;A document without date counts as recent." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="drc6"><mxGeometry x="0" y="30" width="440" height="120" as="geometry"/></mxCell>
<mxCell id="drc9" value="In scope, to parse" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#DCE8F7;strokeColor=#2F6DB5;swimlaneFillColor=#FFFFFF;fontColor=#16324F;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="140" y="428" width="240" height="82" as="geometry"/></mxCell>
<mxCell id="drc10" value="New IDDOC, or REF / revision / date changed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="drc9"><mxGeometry x="0" y="30" width="240" height="52" as="geometry"/></mxCell>
<mxCell id="drc11" value="SUCCESS" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#D5EED8;strokeColor=#2E7D32;swimlaneFillColor=#FFFFFF;fontColor=#123D16;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="640" y="428" width="240" height="65" as="geometry"/></mxCell>
<mxCell id="drc12" value="Passages written." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="drc11"><mxGeometry x="0" y="30" width="240" height="35" as="geometry"/></mxCell>
<mxCell id="drc13" value="ERROR" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F5F5F5;strokeColor=#9E9E9E;swimlaneFillColor=#FFFFFF;fontColor=#424242;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="640" y="578" width="240" height="99" as="geometry"/></mxCell>
<mxCell id="drc14" value="Parse failed or &gt; 200 s.&lt;br&gt;Retried with the next-best file, and by the next run." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="drc13"><mxGeometry x="0" y="30" width="240" height="69" as="geometry"/></mxCell>
<mxCell id="drc15" value="IMAGES_PENDING / EMPTY_TEXT" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FDE2C4;strokeColor=#D9822B;swimlaneFillColor=#FFFFFF;fontColor=#6B3500;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="640" y="748" width="240" height="65" as="geometry"/></mxCell>
<mxCell id="drc16" value="No text: waits for its images." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="drc15"><mxGeometry x="0" y="30" width="240" height="35" as="geometry"/></mxCell>
<mxCell id="drc17" value="SKIP_* / SKIPPED_*" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F5F5F5;strokeColor=#9E9E9E;swimlaneFillColor=#FFFFFF;fontColor=#424242;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="140" y="658" width="240" height="116" as="geometry"/></mxCell>
<mxCell id="drc18" value="TOO_LARGE, EMPTY_SMALL_FILE, EMPTY_FOLDER,&lt;br&gt;REF_OUT_OF_SCOPE, SOURCE_REMOVED, REF_MANUAL, CATEGORY_EXCLUDED." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="drc17"><mxGeometry x="0" y="30" width="240" height="86" as="geometry"/></mxCell>
