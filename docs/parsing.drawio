<diagram name="1 · Daily job" id="jb"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="2289" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="jbc1" value="&lt;b style=&quot;font-size:24px&quot;&gt;QualiBOT parsing — from Intraqual documents to the search index&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#546E7A&quot;&gt;Job D_1_Qualibot_Parsing_Pipeline, task by task: what each task reads, does and writes. Values are the PROD settings.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#16324F;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="60" as="geometry"/></mxCell>
