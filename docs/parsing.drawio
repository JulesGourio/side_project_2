<mxfile host="app.diagrams.net"><diagram name="Parsing quotidien (D_1_Qualibot_Parsing_Pipeline)" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="n2" value="QualiBOT parsing : du document Intraqual à l'index (job D_1_Qualibot_Parsing_Pipeline, 04:00)" style="text;html=1;whiteSpace=wrap;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="40" as="geometry"/></mxCell>
<mxCell id="n3" value="Sources et références" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;align=center;fillColor=#eeeeee;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="330" height="28" as="geometry"/></mxCell>
<mxCell id="n4" value="Tâches du job" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;align=center;fillColor=#eeeeee;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="440" height="28" as="geometry"/></mxCell>
<mxCell id="n5" value="Tables, volumes, index produits" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;align=center;fillColor=#eeeeee;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="850" y="60" width="360" height="28" as="geometry"/></mxCell>
<mxCell id="n6" value="&lt;b&gt;Tables Intraqual&lt;/b&gt; (reference_read_env = prod)&lt;br&gt;prod_gold.quality_system.document_revisions_intraqual&lt;br&gt;category_ancestors_intraqual&lt;br&gt;prod_bronze.headers_others.headers_intraqual_gd_doc (noms métier)&lt;br&gt;prod_landingzone.intraqual (fichiers sources)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="330" height="130" as="geometry"/></mxCell>
<mxCell id="n7" value="&lt;b&gt;Périmètre&lt;/b&gt; (config.py)&lt;br&gt;DOC_SCOPE_FILTER : courant, état validé, non masqué&lt;br&gt;Racines SCOPE_ROOT_IDCATS + sous-catégories SCOPE_SUB_IDCATS&lt;br&gt;Division : AS / IS / DIRECTIVE / GROUP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="330" height="110" as="geometry"/></mxCell>
<mxCell id="n8" value="&lt;b&gt;Paramètres du job&lt;/b&gt;&lt;br&gt;run_mode : incremental / full / rechunk&lt;br&gt;parse_filter, max_parse_files = 500&lt;br&gt;max_source_staleness_hours = 36&lt;br&gt;describe_images, redescribe_all_images" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="330" height="150" as="geometry"/></mxCell>
<mxCell id="n9" value="&lt;b&gt;1_categories&lt;/b&gt; (cluster CPU méta)&lt;br&gt;Lit les tables Intraqual, échoue si une source a plus de 36 h&lt;br&gt;Construit les catégories et la division de chaque document" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="100" width="440" height="100" as="geometry"/></mxCell>
<mxCell id="n10" value="&lt;b&gt;2_manifest&lt;/b&gt; (CPU méta)&lt;br&gt;Liste des documents du périmètre (garde-fou : baisse &amp;gt; 30 % refusée)&lt;br&gt;Supprime chunks, image_metadata, parsed_documents des IDDOC sortis du périmètre&lt;br&gt;Catégorie manquante : reprise de la révision précédente, sinon document ignoré" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="220" width="440" height="110" as="geometry"/></mxCell>
<mxCell id="n11" value="&lt;b&gt;3_parse&lt;/b&gt; (CPU, parse_cpu_cluster)&lt;br&gt;Sélection : reparsé seulement si (IDDOC, document_sha256) n'a pas de ligne SUCCESS&lt;br&gt;Plafond max_parse_files&lt;br&gt;Docling : PDF, DOCX, PPTX, HTML ; xml_fallback si Docling échoue&lt;br&gt;PDF scanné (moins de 150 caractères) : statut pending_llm_ocr → OCR par modèle de vision&lt;br&gt;Images extraites vers le volume images" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="350" width="440" height="150" as="geometry"/></mxCell>
<mxCell id="n12" value="&lt;b&gt;3b_needs_gpu&lt;/b&gt;&lt;br&gt;plus de 30 PDF à parser ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="480" y="520" width="240" height="90" as="geometry"/></mxCell>
<mxCell id="n13" value="&lt;b&gt;3b_parse_pdf&lt;/b&gt;&lt;br&gt;Docling sur GPU (cluster sans politique, great_expectations 0.18.22)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="640" width="140" height="110" as="geometry"/></mxCell>
<mxCell id="n14" value="&lt;b&gt;3c_chunks&lt;/b&gt; (CPU)&lt;br&gt;Reprise des erreurs, découpe aux titres 1 à 3 : 300 / 450 / 550 tokens, 1950 caractères au plus, recouvrement 12 %&lt;br&gt;Contrôles qualité Great Expectations&lt;br&gt;Crée les lignes d'images à décrire" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="780" width="440" height="130" as="geometry"/></mxCell>
<mxCell id="n15" value="&lt;b&gt;4_describe_images&lt;/b&gt; (CPU, I/O)&lt;br&gt;Modèle de vision databricks-gpt-6-luna (repli gpt-5-6-luna) : une description par image&lt;br&gt;La description devient un passage de chunks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="930" width="440" height="100" as="geometry"/></mxCell>
<mxCell id="n16" value="&lt;b&gt;5_sync_index&lt;/b&gt; (CPU méta)&lt;br&gt;Synchronise l'index Vector Search chunks_index (embeddings databricks-qwen3-embedding-0-6b)&lt;br&gt;Alimenté depuis la table chunks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="1050" width="440" height="100" as="geometry"/></mxCell>
<mxCell id="n17" value="&lt;b&gt;6_update_kb_metadata&lt;/b&gt;&lt;br&gt;Écrit dans le Lakebase : doc_catalog (REF, titre, révision, date), doc_references (codes cités), catalog_metadata (date de la base)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="1170" width="440" height="100" as="geometry"/></mxCell>
<mxCell id="n18" value="&lt;b&gt;Tables de pilotage&lt;/b&gt; (prod_proj.qualibot)&lt;br&gt;category_reference, parse_manifest&lt;br&gt;parsing_run_scope, parsing_gpu_queue (relais CPU → GPU, réécrites à chaque run)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="100" width="360" height="110" as="geometry"/></mxCell>
<mxCell id="n19" value="&lt;b&gt;parsing_checkpoint&lt;/b&gt;&lt;br&gt;Une ligne par tentative : IDDOC, document_sha256, ingestion_timestamp, parse_status, parseur, contenu extrait&lt;br&gt;Cache du parsing : ne jamais supprimer sans vérifier" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="230" width="360" height="130" as="geometry"/></mxCell>
<mxCell id="n20" value="&lt;b&gt;Volume images&lt;/b&gt;&lt;br&gt;Images extraites de chaque document" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="380" width="360" height="100" as="geometry"/></mxCell>
<mxCell id="n21" value="&lt;b&gt;parsed_documents, chunks, image_metadata&lt;/b&gt;&lt;br&gt;chunks : passages texte et images, division, chunk_preprocessed (codes REF normalisés)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="500" width="360" height="130" as="geometry"/></mxCell>
<mxCell id="n22" value="&lt;b&gt;chunks_index&lt;/b&gt;&lt;br&gt;Lu par le chat et la recherche d'impact" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="1050" width="360" height="100" as="geometry"/></mxCell>
<mxCell id="n23" value="&lt;b&gt;Lakebase&lt;/b&gt; (doccompare)&lt;br&gt;doc_catalog, doc_references, catalog_metadata" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="1170" width="360" height="100" as="geometry"/></mxCell>
<mxCell id="n24" value="&lt;b&gt;Plannings&lt;/b&gt;&lt;br&gt;04:00 Europe/Brussels, un seul run à la fois (max_concurrent_runs = 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="1290" width="360" height="90" as="geometry"/></mxCell>
