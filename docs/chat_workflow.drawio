<mxCell id="tqc7" value="One transaction per turn:&lt;br&gt;&lt;b&gt;chat_turns&lt;/b&gt;: 1 row (settings, timings, tokens, cost, mlflow_trace_id)&lt;br&gt;&lt;b&gt;chat_retrieved_chunks&lt;/b&gt;: 1 row per passage, kept or not&lt;br&gt;&lt;b&gt;app_errors&lt;/b&gt;: 1 row per warning / error&lt;br&gt;Also &lt;b&gt;chat_sessions&lt;/b&gt;, &lt;b&gt;chat_messages&lt;/b&gt; (the conversation)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="tqc6"><mxGeometry x="0" y="30" width="400" height="120" as="geometry"/></mxCell>
