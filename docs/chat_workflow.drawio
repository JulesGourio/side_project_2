<mxCell id="tqc19" value="&lt;b&gt;02:00&lt;/b&gt; and &lt;b&gt;14:00&lt;/b&gt;.&lt;br&gt;Lakebase tables → staging volume → Delta tables in &lt;b&gt;prod_proj.qualibot&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="tqc18"><mxGeometry x="0" y="30" width="400" height="69" as="geometry"/></mxCell>
