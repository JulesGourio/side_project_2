<mxfile host="app.diagrams.net"><diagram name="Chat: question vers reponse (PROD)" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="n2" value="QualiBOT chat : de la question à la réponse (config PROD)" style="text;html=1;whiteSpace=wrap;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="40" as="geometry"/></mxCell>
<mxCell id="n3" value="Configuration, prompts, données (entrées)" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;align=center;fillColor=#eeeeee;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="300" height="28" as="geometry"/></mxCell>
<mxCell id="n4" value="Déroulé d'un tour (moteur server/services/chat/engine)" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;align=center;fillColor=#eeeeee;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="350" y="60" width="420" height="28" as="geometry"/></mxCell>
<mxCell id="n5" value="Traces et sorties" style="text;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;align=center;fillColor=#eeeeee;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="330" height="28" as="geometry"/></mxCell>
<mxCell id="n6" value="&lt;b&gt;0. Utilisateur&lt;/b&gt;&lt;br&gt;Question + sélecteur de division AS / IS / ALL (navigateur, React)&lt;br&gt;WebSocket chat : &lt;i&gt;routers/chat/ws.py&lt;/i&gt;&lt;br&gt;Accès : groupes de la table users (Lakebase)&lt;br&gt;Préfixe &lt;i&gt;[Date: AAAA-MM-JJ]&lt;/i&gt; ajouté à la question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="420" height="100" as="geometry"/></mxCell>
<mxCell id="n7" value="&lt;b&gt;1. Préparation du tour&lt;/b&gt;&lt;br&gt;Historique nettoyé (marqueurs ⟦n⟧ retirés), date retirée&lt;br&gt;TurnLog créé : trace_id &lt;i&gt;chat-…&lt;/i&gt;&lt;br&gt;Config du tour enregistrée (chat_turns.config)&lt;br&gt;Pont de traduction (CHAT_TRANSLATE_BRIDGE_ENABLED) : &lt;b&gt;désactivé&lt;/b&gt; en PROD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="214" width="420" height="100" as="geometry"/></mxCell>
<mxCell id="n8" value="&lt;b&gt;2. Détection de la langue&lt;/b&gt;&lt;br&gt;fastText lid.176 (&lt;i&gt;fast_lang_guess&lt;/i&gt;) sur la question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="330" width="420" height="56" as="geometry"/></mxCell>
<mxCell id="n9" value="Premier message,&lt;br&gt;fr ou en sûr,&lt;br&gt;CHAT_TRANSLATE_ONLY = on ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="410" y="404" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="n10" value="&lt;b&gt;3a. Traduction seule (1 appel LLM)&lt;/b&gt;&lt;br&gt;translate_query.md → langue opposée&lt;br&gt;Modèle : databricks-gpt-6-luna (repli gpt-5-6-luna)&lt;br&gt;max 600 tokens, timeout 15 s&lt;br&gt;&lt;b&gt;2 requêtes&lt;/b&gt; : question telle quelle + traduction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="160" y="540" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="n11" value="&lt;b&gt;3b. Réécriture bilingue (1 appel LLM)&lt;/b&gt;&lt;br&gt;rewrite.md (+ rewrite_original.md si langue ≠ fr/en)&lt;br&gt;Modèle : databricks-gpt-6-luna (repli gpt-5-6-luna)&lt;br&gt;reasoning_effort = low, max 2000 tokens, timeout 15 s&lt;br&gt;Suite de conversation, ou langue autre / incertaine&lt;br&gt;&lt;b&gt;2 requêtes&lt;/b&gt; FR + EN ; &lt;b&gt;3 requêtes&lt;/b&gt; FR + EN + langue d'origine pour une langue étrangère&lt;br&gt;strip_added_noise : retire société / type de document ajoutés" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="540" width="330" height="215" as="geometry"/></mxCell>
<mxCell id="n12" value="&lt;b&gt;4. Requêtes retenues&lt;/b&gt;&lt;br&gt;Doublons supprimés (casse ignorée), codes REF normalisés (&lt;i&gt;SF-1027 [SF1027]&lt;/i&gt;)&lt;br&gt;Échec du LLM : tour dégradé, la question seule est cherchée avec 2 × top_k&lt;br&gt;Stop words : CHAT_STOPWORDS = off" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="764" width="420" height="98" as="geometry"/></mxCell>
<mxCell id="n13" value="&lt;b&gt;5. REF nommées&lt;/b&gt;&lt;br&gt;Catalogue doc_catalog : REF citées dans la question puis les tours précédents (6 max, variantes de langue incluses)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="874" width="420" height="66" as="geometry"/></mxCell>
<mxCell id="n14" value="&lt;b&gt;6. Vector Search (en parallèle, 1 appel par requête)&lt;/b&gt;&lt;br&gt;Index prod_proj.qualibot.&lt;b&gt;chunks_index&lt;/b&gt;, requête HYBRID (embeddings databricks-qwen3-embedding-0-6b + BM25)&lt;br&gt;Reranker &lt;b&gt;databricks_reranker&lt;/b&gt; sur REF, semantic_headers, chunk_text&lt;br&gt;&lt;b&gt;num_results = 32&lt;/b&gt; par requête (CHAT_RERANK_TOP_K = CHAT_PAIR_RERANK_TOP_K = 32, plafond 50 avec reranker)&lt;br&gt;Recherche brute : CHAT_RAW_TOP_K = 0 (aucune)&lt;br&gt;Filtre filters_json : division IN (AS ou IS, GROUP) ; ALL = sans filtre&lt;br&gt;Texte coupé à 20 000 caractères ; passerelle vs_gate : 8 requêtes simultanées max, reprise sur 429 / 5xx / timeout&lt;br&gt;Une requête qui échoue est ignorée si les autres répondent ; toutes en échec : erreur" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="954" width="420" height="224" as="geometry"/></mxCell>
<mxCell id="n15" value="&lt;b&gt;7. Fusion&lt;/b&gt;&lt;br&gt;Une ligne par passage, chaque trace de requête gardée (rang, score, via)&lt;br&gt;Tri par meilleur score du reranker (CHAT_PASSAGE_ORDER = score)&lt;br&gt;Plafond &lt;b&gt;CHAT_MAX_SEARCH_PASSAGES = 50&lt;/b&gt; : le reste est marqué over_cap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="1182" width="420" height="92" as="geometry"/></mxCell>
<mxCell id="n16" value="&lt;b&gt;8. Recherche par REF nommée&lt;/b&gt;&lt;br&gt;HYBRID sans reranker, filtre REF IN (REF nommées), 8 passages, ajoutés devant la fusion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="1292" width="420" height="76" as="geometry"/></mxCell>
<mxCell id="n17" value="&lt;b&gt;9. Questions de citation&lt;/b&gt; (« quels documents citent X ? »)&lt;br&gt;Codes de la question → Lakebase doc_references : liste complète&lt;br&gt;10 documents les plus récents : HYBRID filtré sur REF, 20 passages&lt;br&gt;Bloc « exact_citations » donné au modèle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="1386" width="420" height="106" as="geometry"/></mxCell>
<mxCell id="n18" value="&lt;b&gt;10. Une langue par document&lt;/b&gt;&lt;br&gt;Variante gardée : celle qui cite un code de la question, sinon la langue de la question, sinon la plus récente, sinon la mieux classée&lt;br&gt;Passages écartés : other_language" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="1510" width="420" height="92" as="geometry"/></mxCell>
<mxCell id="n19" value="&lt;b&gt;11. Construction du prompt&lt;/b&gt;&lt;br&gt;Système : division.md (AS / IS) ou all.md (+ as_reference_ordering.md pour AS) puis base.md&lt;br&gt;Historique, puis documents numérotés [1], [2]… avec titre, révision courante, date, division (doc_catalog)&lt;br&gt;Bloc exact_citations, question, rappel de langue (language_reminder.md)&lt;br&gt;Les documents passent avant la question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="1620" width="420" height="150" as="geometry"/></mxCell>
<mxCell id="n20" value="&lt;b&gt;12. Réponse (streaming)&lt;/b&gt;&lt;br&gt;Modèle : &lt;b&gt;databricks-gpt-6-luna&lt;/b&gt;, repli databricks-gpt-5-6-luna&lt;br&gt;max 8000 tokens (raisonnement inclus), plancher de raisonnement 6000&lt;br&gt;Délai 1er token 90 s, arrêt si silence 60 s, 3 rounds (attente 2 / 8 / 20 s), 2 reprises de texte au plus&lt;br&gt;32 réponses simultanées au plus (file d'attente)&lt;br&gt;Message « still_searching » si la recherche dépasse 15 s ; pings keepalive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="1788" width="420" height="190" as="geometry"/></mxCell>
<mxCell id="n21" value="&lt;b&gt;13. Citations&lt;/b&gt;&lt;br&gt;CitationStreamParser : marqueurs [n] → ⟦n⟧, sources numérotées par ordre d'apparition ; table finale des documents (REF, titre, version, statut, division)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="1996" width="420" height="76" as="geometry"/></mxCell>
<mxCell id="n22" value="&lt;b&gt;14. Envoi au navigateur&lt;/b&gt;&lt;br&gt;delta, sources + citations, metadata (trace_id), done. Échec : message unique TIRED_MESSAGE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="2090" width="420" height="66" as="geometry"/></mxCell>
<mxCell id="n23" value="&lt;b&gt;15. Après l'envoi&lt;/b&gt;&lt;br&gt;Sauvegarde des messages, puis export MLflow, puis écriture chat_turns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="2174" width="420" height="66" as="geometry"/></mxCell>
<mxCell id="n24" value="&lt;b&gt;Réglages PROD&lt;/b&gt; (utils/deploy/target_env.json)&lt;br&gt;CHAT_INDEX = prod_proj.qualibot.chunks_index&lt;br&gt;CHAT_TRANSLATE_ONLY = on&lt;br&gt;CHAT_MLFLOW_EXPERIMENT = /Shared/Experiment/qualibot_chat_traces (id 1092094093369059)&lt;br&gt;Autres valeurs : défauts de engine/config.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="300" height="170" as="geometry"/></mxCell>
<mxCell id="n25" value="&lt;b&gt;Prompts&lt;/b&gt; (server/prompts/chat/)&lt;br&gt;rewrite.md, rewrite_original.md, translate_query.md&lt;br&gt;system/ : base, all, division, as_reference_ordering&lt;br&gt;language_reminder.md, exact_citations.md&lt;br&gt;Versions liées via les tags chat_prompt.&amp;lt;clé&amp;gt; de l'expérience MLflow (job Z_3_Register_Chat_Prompts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="n26" value="&lt;b&gt;fastText&lt;/b&gt; lid.176.ftz (third_party/fasttext)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="460" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="n27" value="&lt;b&gt;chunks_index&lt;/b&gt; (Vector Search)&lt;br&gt;Source : table chunks (tâche 5_sync_index du parsing)&lt;br&gt;Colonnes : REF, semantic_headers, chunk_text, division, url…" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="960" width="300" height="120" as="geometry"/></mxCell>
<mxCell id="n28" value="&lt;b&gt;Lakebase&lt;/b&gt; (projet qualibot, base doccompare)&lt;br&gt;doc_catalog : REF, titre, révision, date (rechargé toutes les 30 min)&lt;br&gt;doc_references : codes cités par document&lt;br&gt;users : groupes d'accès" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1100" width="300" height="130" as="geometry"/></mxCell>
<mxCell id="n29" value="&lt;b&gt;Endpoints de modèles&lt;/b&gt;&lt;br&gt;databricks-gpt-6-luna&lt;br&gt;databricks-gpt-5-6-luna&lt;br&gt;databricks_reranker, databricks-qwen3-embedding-0-6b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1250" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="n30" value="&lt;b&gt;Lakebase : écrit par store_chat_turn&lt;/b&gt;&lt;br&gt;chat_turns : étapes, durées *_ms, config, modèles, tokens, coût, statut ok / degraded / error / aborted + codes d'avertissement&lt;br&gt;chat_retrieved_chunks : chaque passage, gardé ou écarté (raison, hits, score)&lt;br&gt;app_errors : un enregistrement par erreur / avertissement (stage, origin, fingerprint)&lt;br&gt;chat_messages, chat_sessions, chat_feedbacks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="2000" width="330" height="170" as="geometry"/></mxCell>
<mxCell id="n31" value="&lt;b&gt;MLflow : une trace par tour&lt;/b&gt; (mlflow_turns.export_turn)&lt;br&gt;chat_turn → question → réponse (tags : division, statut, avertissements)&lt;br&gt;├ retrieval : rewrite (LLM), search (1 span par appel VS), ref_lookup, citation_lookup, passages_sent (RETRIEVER, texte complet)&lt;br&gt;├ answer : queue_wait, call_1…n (time_to_first_token, generation), tokens, coût, repli&lt;br&gt;└ persist&lt;br&gt;Tables UC prod_proj.qualibot.&amp;lt;id expérience&amp;gt;_otel_* ; l'id de trace est stocké dans chat_turns.mlflow_trace_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="1700" width="330" height="290" as="geometry"/></mxCell>
<mxCell id="n32" value="&lt;b&gt;Retour utilisateur&lt;/b&gt;&lt;br&gt;Pouce haut / bas → chat_feedbacks + évaluation « user_vote » sur la trace ; commentaire → « user_comment »" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="1480" width="330" height="100" as="geometry"/></mxCell>
<mxCell id="n33" value="&lt;b&gt;Job D_2_Qualibot_Score_Chat_Traces&lt;/b&gt; (02:30, asynchrone)&lt;br&gt;Scorers gratuits sur chaque tour, juges LLM sur échantillon (taux dans chat_scorers.py)&lt;br&gt;Jamais dans un tour de chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="1300" width="330" height="130" as="geometry"/></mxCell>
<mxCell id="n34" value="&lt;b&gt;Job D_1_Qualibot_Lakebase_Export_To_Volume&lt;/b&gt; (02:00 et 14:00)&lt;br&gt;Lakebase → volume staging → tables Delta : alertes SQL et dashboard d'usage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="1120" width="330" height="140" as="geometry"/></mxCell>
<mxCell id="n35" value="&lt;b&gt;Navigateur&lt;/b&gt;&lt;br&gt;Réponse en direct, puces de sources, tableau des documents, pouces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="330" height="90" as="geometry"/></mxCell>
<mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="n19" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="n20" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="n21" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="n22" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e50" value="oui" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e51" value="non" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="n9" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
