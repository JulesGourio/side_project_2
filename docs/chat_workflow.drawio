<mxCell id="tqc1" value="&lt;b style=&quot;font-size:24px&quot;&gt;④ Traces and quality&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#546E7A&quot;&gt;What is recorded for every turn, and the jobs that read it. All of it runs after the answer is sent.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#16324F;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="60" as="geometry"/></mxCell>
