<mxCell id="ovc56" value="1 trace per turn in &lt;b&gt;qualibot_chat_traces&lt;/b&gt;.&lt;br&gt;Scored every night: free scorers + LLM judges." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="ovc55"><mxGeometry x="0" y="30" width="250" height="86" as="geometry"/></mxCell>
<mxCell id="ove57" value="after the last event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;strokeColor=#78909C;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ovc10" target="ovc51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ove58" value="store_chat_turn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;strokeColor=#78909C;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.4;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="ovc51" target="ovc53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ove59" value="export_turn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;strokeColor=#78909C;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ovc51" target="ovc55"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1605.0" y="888"/><mxPoint x="885.0" y="888"/></Array></mxGeometry></mxCell>
<mxCell id="ovc61" value="&lt;b&gt;Per turn in PROD:&lt;/b&gt; 2 LLM calls (1 translate or rewrite + 1 answer) · 2–3 Vector Search queries (+1 for a citation question) · ≤ 50 passages from the search (+ ≤ 20 citation passages) before one language is kept per document." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#455A64;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="948" width="1600" height="40" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram name="2 · Query building and retrieval" id="rt"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1470" pageHeight="2210" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="rtb41" value="3 · RETRIEVAL" style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#F2F9F3;strokeColor=#D5DBE0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#607D8B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1103" width="920" height="1047" as="geometry"/></mxCell>
<mxCell id="rtb23" value="2 · SEARCH QUERIES (1 LLM call)" style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#FFF8F0;strokeColor=#D5DBE0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#607D8B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="431" width="920" height="662" as="geometry"/></mxCell>
<mxCell id="rtb7" value="1 · LANGUAGE" style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#F3F7FC;strokeColor=#D5DBE0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#607D8B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="920" height="311" as="geometry"/></mxCell>
<mxCell id="rtc1" value="&lt;b style=&quot;font-size:24px&quot;&gt;② Query building and retrieval&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#546E7A&quot;&gt;From the question to the passages handed to the answer model. Values are the PROD settings (app.yaml + target_env.json).&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#16324F;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="60" as="geometry"/></mxCell>
<mxCell id="rtc2" value="User question" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#E0E0E0;strokeColor=#424242;swimlaneFillColor=#FFFFFF;fontColor=#212121;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="860" height="99" as="geometry"/></mxCell>
<mxCell id="rtc3" value="Division filter from the UI: &lt;b&gt;AS&lt;/b&gt;, &lt;b&gt;IS&lt;/b&gt; or &lt;b&gt;ALL&lt;/b&gt;.&lt;br&gt;The client prefixes &lt;b&gt;[Date: YYYY-MM-DD]&lt;/b&gt;; removed before the search, kept for the answer.&lt;br&gt;History: the earlier messages, trimmed to the last &lt;b&gt;8,000 tokens&lt;/b&gt; (CHAT_MAX_HISTORY_TOKENS)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="rtc2"><mxGeometry x="0" y="30" width="860" height="69" as="geometry"/></mxCell>
<mxCell id="rtc4" value="Language guess" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#DCE8F7;strokeColor=#2F6DB5;swimlaneFillColor=#FFFFFF;fontColor=#16324F;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="60" y="299" width="860" height="82" as="geometry"/></mxCell>
<mxCell id="rtc5" value="&lt;b&gt;fastText lid.176&lt;/b&gt;, local model (no LLM call).&lt;br&gt;Trusted only when its probability is &lt;b&gt;≥ 0.65&lt;/b&gt; and the question has &lt;b&gt;≥ 2 letters&lt;/b&gt;; otherwise the language is &quot;unsure&quot;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="rtc4"><mxGeometry x="0" y="30" width="860" height="52" as="geometry"/></mxCell>
<mxCell id="rte6" value="question" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#37474F;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="rtc2" target="rtc4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rtc8" value="First message of the conversation&lt;br&gt;AND French or English?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#4D3B00;fontFamily=Helvetica;spacing=18;" vertex="1" parent="1"><mxGeometry x="310.0" y="471" width="360" height="130" as="geometry"/></mxCell>
<mxCell id="rte9" value="fr / en / unsure" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#37474F;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="rtc4" target="rtc8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rtc10" value="Translate&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#D9822B&quot;&gt;LLM call&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FDE2C4;strokeColor=#D9822B;swimlaneFillColor=#FFFFFF;fontColor=#6B3500;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="60" y="661" width="415.0" height="175" as="geometry"/></mxCell>
<mxCell id="rtc11" value="CHAT_TRANSLATE_ONLY = on (all targets).&lt;br&gt;Prompt &lt;b&gt;translate_query.md&lt;/b&gt;: translate into the other language, keep codes and acronyms, add nothing.&lt;br&gt;Model: &lt;b&gt;gpt-6-luna&lt;/b&gt; → fallback &lt;b&gt;gpt-5-6-luna&lt;/b&gt;.&lt;br&gt;≤ &lt;b&gt;600&lt;/b&gt; tokens · timeout &lt;b&gt;15 s&lt;/b&gt; · reasoning effort &lt;b&gt;low&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Queries:&lt;/b&gt; the question as asked + its translation = &lt;b&gt;2&lt;/b&gt;.&lt;br&gt;Each searched with k = &lt;b&gt;32&lt;/b&gt; (CHAT_PAIR_RERANK_TOP_K)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="rtc10"><mxGeometry x="0" y="30" width="415.0" height="145" as="geometry"/></mxCell>
<mxCell id="rtc12" value="Bilingual rewrite&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#D9822B&quot;&gt;LLM call&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FDE2C4;strokeColor=#D9822B;swimlaneFillColor=#FFFFFF;fontColor=#6B3500;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="505.0" y="661" width="415.0" height="226" as="geometry"/></mxCell>
<mxCell id="rtc13" value="Prompt &lt;b&gt;rewrite.md&lt;/b&gt;: one standalone query written twice, FR: and EN:, the follow-up made explicit, acronyms kept and expanded when certain.&lt;br&gt;+ &lt;b&gt;rewrite_original.md&lt;/b&gt; when the question is not FR/EN: a 3rd query in its own language.&lt;br&gt;Model: &lt;b&gt;gpt-6-luna&lt;/b&gt; → fallback &lt;b&gt;gpt-5-6-luna&lt;/b&gt;.&lt;br&gt;≤ &lt;b&gt;2,000&lt;/b&gt; tokens · timeout &lt;b&gt;15 s&lt;/b&gt; · reasoning effort &lt;b&gt;low&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Queries:&lt;/b&gt; FR + EN = &lt;b&gt;2&lt;/b&gt; (3 with the original-language one). The question as asked is not searched.&lt;br&gt;Each searched with k = &lt;b&gt;32&lt;/b&gt; (CHAT_RERANK_TOP_K)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="rtc12"><mxGeometry x="0" y="30" width="415.0" height="196" as="geometry"/></mxCell>
<mxCell id="rte14" value="Yes — opening message" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#37474F;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rtc8" target="rtc10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rte15" value="No — follow-up, other language or unsure" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#37474F;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rtc8" target="rtc12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rtc16" value="Query clean-up" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#DCE8F7;strokeColor=#2F6DB5;swimlaneFillColor=#FFFFFF;fontColor=#16324F;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="60" y="957" width="860" height="116" as="geometry"/></mxCell>
<mxCell id="rtc17" value="Company and document-type words added by the model (&quot;Latécoère&quot;, &quot;quality documents&quot;…) are removed unless the user wrote them.&lt;br&gt;Stop-word removal: &lt;b&gt;off&lt;/b&gt; (CHAT_STOPWORDS).&lt;br&gt;Reference codes get their canonical form too: &lt;b&gt;SF-1027&lt;/b&gt; → &lt;b&gt;SF-1027 [SF1027]&lt;/b&gt;, the spelling stored in the index.&lt;br&gt;Duplicate queries dropped." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="rtc16"><mxGeometry x="0" y="30" width="860" height="86" as="geometry"/></mxCell>
<mxCell id="rte18" value="2 queries" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#37474F;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rtc10" target="rtc16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rte19" value="2 or 3 queries" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#37474F;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rtc12" target="rtc16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rtc20" value="If every model of the chain fails" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F5F5F5;strokeColor=#9E9E9E;swimlaneFillColor=#FFFFFF;fontColor=#424242;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="1010" y="661" width="400" height="116" as="geometry"/></mxCell>
<mxCell id="rtc21" value="Translate or rewrite: the turn goes on with the question as asked, &lt;b&gt;1 query&lt;/b&gt;, k = 2 × 32 = 64, cut to &lt;b&gt;50&lt;/b&gt; (reranker maximum).&lt;br&gt;The turn is flagged &lt;b&gt;degraded&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="rtc20"><mxGeometry x="0" y="30" width="400" height="86" as="geometry"/></mxCell>
<mxCell id="rte22" value="all models failed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;strokeColor=#C62828;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.257;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rtc12" target="rtc20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rtc24" value="Vector Search — one query per search query, in parallel&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#2E7D32&quot;&gt;2–3 calls&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#D5EED8;strokeColor=#2E7D32;swimlaneFillColor=#FFFFFF;fontColor=#123D16;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="60" y="1143" width="860" height="150" as="geometry"/></mxCell>
<mxCell id="rtc25" value="&lt;b&gt;query_type = HYBRID&lt;/b&gt;: vector similarity + keyword match.&lt;br&gt;&lt;b&gt;Reranker&lt;/b&gt;: databricks_reranker on the columns &lt;b&gt;REF&lt;/b&gt;, &lt;b&gt;semantic_headers&lt;/b&gt;, &lt;b&gt;chunk_text&lt;/b&gt;.&lt;br&gt;&lt;b&gt;num_results = 32&lt;/b&gt; per query; Vector Search accepts at most 50 with the reranker.&lt;br&gt;Search without reranker: &lt;b&gt;none&lt;/b&gt; (CHAT_RAW_TOP_K = 0).&lt;br&gt;Filter: division &lt;b&gt;IN (AS or IS, GROUP)&lt;/b&gt;; ALL = no filter.&lt;br&gt;A failed query is dropped; if all fail the user gets an error." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="rtc24"><mxGeometry x="0" y="30" width="860" height="120" as="geometry"/></mxCell>
<mxCell id="rtc26" value="Merge and cap" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#DCE8F7;strokeColor=#2F6DB5;swimlaneFillColor=#FFFFFF;fontColor=#16324F;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="60" y="1363" width="860" height="99" as="geometry"/></mxCell>
<mxCell id="rtc27" value="Same passage from several queries kept once (by chunk_id).&lt;br&gt;Order: best &lt;b&gt;reranker score&lt;/b&gt; over the queries (CHAT_PASSAGE_ORDER = score).&lt;br&gt;Keep the first &lt;b&gt;50&lt;/b&gt; (CHAT_MAX_SEARCH_PASSAGES); the others are logged as &lt;b&gt;over_cap&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="rtc26"><mxGeometry x="0" y="30" width="860" height="69" as="geometry"/></mxCell>
<mxCell id="rte28" value="≤ 64 passages (≤ 96 with 3 queries)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#37474F;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="rtc24" target="rtc26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rtc29" value="Does the question ask&lt;br&gt;which documents cite a code?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#4D3B00;fontFamily=Helvetica;spacing=18;" vertex="1" parent="1"><mxGeometry x="140" y="1502" width="340" height="120" as="geometry"/></mxCell>
<mxCell id="rte30" value="≤ 50 passages" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#37474F;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.29;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rtc26" target="rtc29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rtc31" value="Citation lookup&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#2E7D32&quot;&gt;+1 call&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#D5EED8;strokeColor=#2E7D32;swimlaneFillColor=#FFFFFF;fontColor=#123D16;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="530" y="1642" width="390" height="150" as="geometry"/></mxCell>
<mxCell id="rtc32" value="Complete list of the citing documents from &lt;b&gt;doc_references&lt;/b&gt; (not a search).&lt;br&gt;Passages of the &lt;b&gt;10&lt;/b&gt; most recent citing documents: HYBRID query filtered on their REF, k = &lt;b&gt;20&lt;/b&gt;.&lt;br&gt;The list itself (up to &lt;b&gt;30&lt;/b&gt; documents, then counts per division + CSV link) goes to the prompt." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="rtc31"><mxGeometry x="0" y="30" width="390" height="120" as="geometry"/></mxCell>
<mxCell id="rte33" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#37474F;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rtc29" target="rtc31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rtc34" value="One language per document" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#DCE8F7;strokeColor=#2F6DB5;swimlaneFillColor=#FFFFFF;fontColor=#16324F;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="60" y="1862" width="860" height="116" as="geometry"/></mxCell>
<mxCell id="rtc35" value="A document can exist in several language variants (REF suffix FR, EN, ES…). One variant is kept, chosen in this order:&lt;br&gt;1. the variant whose passages cite a code of the question · 2. the most recently published · 3. the question&#x27;s language · 4. the best ranked.&lt;br&gt;Passages of the other variants are logged as &lt;b&gt;other_language&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="rtc34"><mxGeometry x="0" y="30" width="860" height="86" as="geometry"/></mxCell>
<mxCell id="rte36" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#37474F;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.29;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rtc29" target="rtc34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rte37" value="+ ≤ 20 passages" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#37474F;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.77;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rtc31" target="rtc34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rtc38" value="Passages for the answer" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#DCE8F7;strokeColor=#2F6DB5;swimlaneFillColor=#FFFFFF;fontColor=#16324F;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="60" y="2048" width="860" height="82" as="geometry"/></mxCell>
<mxCell id="rtc39" value="≤ 50 search passages (+ ≤ 20 citation passages), grouped by document, best first. → &lt;b&gt;page 3&lt;/b&gt;.&lt;br&gt;Every passage retrieved, kept or set aside, is recorded on the turn (page 4)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="rtc38"><mxGeometry x="0" y="30" width="860" height="52" as="geometry"/></mxCell>
<mxCell id="rte40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#37474F;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="rtc34" target="rtc38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rtc42" value="chunks_index" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#D5EED8;strokeColor=#2E7D32;swimlaneFillColor=#FFFFFF;fontColor=#123D16;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="1010" y="1143" width="400" height="167" as="geometry"/></mxCell>
<mxCell id="rtc43" value="Vector Search index, &lt;b&gt;prod_proj.qualibot&lt;/b&gt;, endpoint &lt;b&gt;qualibot&lt;/b&gt;.&lt;br&gt;Delta Sync (TRIGGERED) on the table &lt;b&gt;chunks&lt;/b&gt;, synced by the parsing job.&lt;br&gt;Embeds &lt;b&gt;chunk_preprocessed&lt;/b&gt; with &lt;b&gt;databricks-qwen3-embedding-0-6b&lt;/b&gt;.&lt;br&gt;Columns returned: REF, title, revision, date, division, chunk_text, cited_codes…" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="rtc42"><mxGeometry x="0" y="30" width="400" height="137" as="geometry"/></mxCell>
<mxCell id="rte44" value="HYBRID + rerank" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;strokeColor=#2E7D32;dashed=1;dashPattern=2 3;endArrow=open;endFill=0;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rtc42" target="rtc24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rtc45" value="doc_references (Lakebase)" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#E5DCF5;strokeColor=#5E35B1;swimlaneFillColor=#FFFFFF;fontColor=#2C1566;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;dashed=0;" vertex="1" parent="1"><mxGeometry x="1010" y="1704.5" width="400" height="99" as="geometry"/></mxCell>
<mxCell id="rtc46" value="One row per (code, citing document), rebuilt by the parsing job.&lt;br&gt;Read from memory: the app reloads it every &lt;b&gt;30 min&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="rtc45"><mxGeometry x="0" y="30" width="400" height="69" as="geometry"/></mxCell>
<mxCell id="rte47" value="complete list" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;strokeColor=#2E7D32;dashed=1;dashPattern=2 3;endArrow=open;endFill=0;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="rtc45" target="rtc31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rte48" value="REF-filtered query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;strokeColor=#2E7D32;dashed=1;dashPattern=2 3;endArrow=open;endFill=0;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="rtc42" target="rtc31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="1293.3"/><mxPoint x="960" y="1672.0"/></Array></mxGeometry></mxCell>
<mxCell id="rtc49" value="Passage budget per turn" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F5F5F5;strokeColor=#9E9E9E;swimlaneFillColor=#FFFFFF;fontColor=#424242;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="1010" y="1853.5" width="400" height="150" as="geometry"/></mxCell>
<mxCell id="rtc50" value="&lt;b&gt;Opening FR/EN message&lt;/b&gt;: 2 queries × 32 = ≤ 64 → cap 50.&lt;br&gt;&lt;b&gt;Follow-up&lt;/b&gt;: 2 queries × 32 = ≤ 64 → cap 50.&lt;br&gt;&lt;b&gt;Other language&lt;/b&gt;: 3 queries × 32 = ≤ 96 → cap 50.&lt;br&gt;&lt;b&gt;Degraded&lt;/b&gt;: 1 query × 50.&lt;br&gt;&lt;b&gt;Citation question&lt;/b&gt;: + ≤ 20.&lt;br&gt;Then one variant per document: often fewer." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="rtc49"><mxGeometry x="0" y="30" width="400" height="120" as="geometry"/></mxCell>
