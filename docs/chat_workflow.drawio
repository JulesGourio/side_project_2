<mxCell id="ovb16" value="ONE CHAT TURN" style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#F3F7FC;strokeColor=#D5DBE0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#607D8B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="1730" height="220" as="geometry"/></mxCell>
<mxCell id="ovc1" value="&lt;b style=&quot;font-size:24px&quot;&gt;QualiBOT chat — one turn, end to end (PROD)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#546E7A&quot;&gt;What happens between the user&#x27;s question and the answer on screen. Pages 2–4 detail each stage.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#16324F;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="60" as="geometry"/></mxCell>
<mxCell id="ovc2" value="Question" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#E0E0E0;strokeColor=#424242;swimlaneFillColor=#FFFFFF;fontColor=#212121;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="250" height="116" as="geometry"/></mxCell>
<mxCell id="ovc3" value="Typed in the chat UI.&lt;br&gt;Division chosen by the user: &lt;b&gt;AS&lt;/b&gt;, &lt;b&gt;IS&lt;/b&gt; or &lt;b&gt;ALL&lt;/b&gt;.&lt;br&gt;History replayed: last &lt;b&gt;8,000 tokens&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="ovc2"><mxGeometry x="0" y="30" width="250" height="86" as="geometry"/></mxCell>
<mxCell id="ovc4" value="① Query building&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#D9822B&quot;&gt;page 2&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FDE2C4;strokeColor=#D9822B;swimlaneFillColor=#FFFFFF;fontColor=#6B3500;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="400" y="140" width="250" height="150" as="geometry"/></mxCell>
<mxCell id="ovc5" value="Language guess (fastText, local).&lt;br&gt;&lt;b&gt;1 LLM call&lt;/b&gt;: translate (opening FR/EN message) or bilingual rewrite (follow-up, other language).&lt;br&gt;→ &lt;b&gt;2 queries&lt;/b&gt; (FR + EN), 3 for another language." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="ovc4"><mxGeometry x="0" y="30" width="250" height="120" as="geometry"/></mxCell>
<mxCell id="ovc6" value="② Retrieval&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#2E7D32&quot;&gt;page 2&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#D5EED8;strokeColor=#2E7D32;swimlaneFillColor=#FFFFFF;fontColor=#123D16;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="760" y="140" width="250" height="150" as="geometry"/></mxCell>
<mxCell id="ovc7" value="&lt;b&gt;1 HYBRID query per search query&lt;/b&gt; + reranker, k = 32 each.&lt;br&gt;Merged, ordered by reranker score, capped at &lt;b&gt;50 passages&lt;/b&gt;.&lt;br&gt;Citation question: + ≤ 20 passages.&lt;br&gt;One language variant per document." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="ovc6"><mxGeometry x="0" y="30" width="250" height="120" as="geometry"/></mxCell>
<mxCell id="ovc8" value="③ Answer&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#D9822B&quot;&gt;page 3&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FDE2C4;strokeColor=#D9822B;swimlaneFillColor=#FFFFFF;fontColor=#6B3500;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="1120" y="140" width="250" height="133" as="geometry"/></mxCell>
<mxCell id="ovc9" value="Prompt: system rules + history + numbered documents + question.&lt;br&gt;&lt;b&gt;1 LLM call&lt;/b&gt;, streamed, ≤ 8,000 tokens.&lt;br&gt;[n] markers → source chips." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="ovc8"><mxGeometry x="0" y="30" width="250" height="103" as="geometry"/></mxCell>
