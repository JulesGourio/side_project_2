<diagram name="3 · Answer generation" id="an"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1470" pageHeight="1160" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="anb11" value="ANSWER MODEL (1 LLM call, streamed)" style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#FFF8F0;strokeColor=#D5DBE0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#607D8B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="523" width="920" height="210" as="geometry"/></mxCell>
<mxCell id="anb7" value="PROMPT (messages sent to the model)" style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#F3F7FC;strokeColor=#D5DBE0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#607D8B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="215" width="920" height="278" as="geometry"/></mxCell>
<mxCell id="anc1" value="&lt;b style=&quot;font-size:24px&quot;&gt;③ Answer generation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#546E7A&quot;&gt;From the passages to the answer on screen: prompt, answer model, citations, stream.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#16324F;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="60" as="geometry"/></mxCell>
<mxCell id="anc2" value="Passages from page 2" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#DCE8F7;strokeColor=#2F6DB5;swimlaneFillColor=#FFFFFF;fontColor=#16324F;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="860" height="65" as="geometry"/></mxCell>
<mxCell id="anc3" value="Grouped by document, best first." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="anc2"><mxGeometry x="0" y="30" width="860" height="35" as="geometry"/></mxCell>
<mxCell id="anc4" value="Prompt assembly" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#DCE8F7;strokeColor=#2F6DB5;swimlaneFillColor=#FFFFFF;fontColor=#16324F;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="60" y="255" width="860" height="218" as="geometry"/></mxCell>
<mxCell id="anc5" value="&lt;b&gt;1. System&lt;/b&gt; = division part + base rules:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;ALL → &lt;b&gt;system/all.md&lt;/b&gt; · AS / IS → &lt;b&gt;system/division.md&lt;/b&gt; (+ &lt;b&gt;as_reference_ordering.md&lt;/b&gt; for AS)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;+ &lt;b&gt;system/base.md&lt;/b&gt;: answer only from the documents, cite them as [n], end with a table of the documents used (REF, title, version, status, division).&lt;br&gt;&lt;b&gt;2. History&lt;/b&gt;: earlier messages (≤ 8,000 tokens).&lt;br&gt;&lt;b&gt;3. Last user message&lt;/b&gt;:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Documents: [1] Document REF &quot;title&quot; (current revision X, published date; division) + its passages, [2] …&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;+ the citation list for a &quot;which documents cite X?&quot; question (&lt;b&gt;exact_citations.md&lt;/b&gt;)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;--- then the question, with its [Date: …] line.&lt;br&gt;&lt;b&gt;4. Language reminder&lt;/b&gt; (&lt;b&gt;language_reminder.md&lt;/b&gt;): answer in the question&#x27;s language." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="anc4"><mxGeometry x="0" y="30" width="860" height="188" as="geometry"/></mxCell>
<mxCell id="ane6" value="≤ 70 passages" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#37474F;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="anc2" target="anc4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="anc8" value="Answer&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#D9822B&quot;&gt;LLM call&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FDE2C4;strokeColor=#D9822B;swimlaneFillColor=#FFFFFF;fontColor=#6B3500;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="60" y="563" width="860" height="150" as="geometry"/></mxCell>
<mxCell id="anc9" value="Model: &lt;b&gt;gpt-6-luna&lt;/b&gt; → fallback &lt;b&gt;gpt-5-6-luna&lt;/b&gt;.&lt;br&gt;Output ≤ &lt;b&gt;8,000 tokens&lt;/b&gt; (reasoning included).&lt;br&gt;Time limits: first token ≤ &lt;b&gt;90 s&lt;/b&gt; · no text for ≤ &lt;b&gt;60 s&lt;/b&gt; · whole answer ≤ &lt;b&gt;240 s&lt;/b&gt;.&lt;br&gt;Up to &lt;b&gt;3 rounds&lt;/b&gt; over the chain; an endpoint that failed rests &lt;b&gt;30 s&lt;/b&gt;.&lt;br&gt;≤ &lt;b&gt;32&lt;/b&gt; answers in flight per app instance (the others wait for a slot).&lt;br&gt;If every model fails: an error message instead of the answer." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="anc8"><mxGeometry x="0" y="30" width="860" height="120" as="geometry"/></mxCell>
<mxCell id="ane10" value="system + history + documents + question" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#37474F;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="anc4" target="anc8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="anc12" value="Citation parsing (while streaming)" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#DCE8F7;strokeColor=#2F6DB5;swimlaneFillColor=#FFFFFF;fontColor=#16324F;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="60" y="803" width="860" height="99" as="geometry"/></mxCell>
<mxCell id="anc13" value="[n] markers removed from the text, their positions kept (⟦n⟧).&lt;br&gt;Sources numbered in order of first appearance; a source chip = REF, title, revision, from &lt;b&gt;doc_catalog&lt;/b&gt;.&lt;br&gt;A marker cut between two chunks is held until the next chunk." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="anc12"><mxGeometry x="0" y="30" width="860" height="69" as="geometry"/></mxCell>
<mxCell id="ane14" value="text stream" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#37474F;endArrow=block;endFill=1;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="anc8" target="anc12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="anc15" value="Answer on screen" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#E0E0E0;strokeColor=#424242;swimlaneFillColor=#FFFFFF;fontColor=#212121;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="60" y="972" width="860" height="82" as="geometry"/></mxCell>
