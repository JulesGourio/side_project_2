<mxCell id="tqc15" value="D_2_Qualibot_Score_Chat_Traces" style="swimlane;html=1;whiteSpace=wrap;startSize=30;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FFF0B8;strokeColor=#B08900;swimlaneFillColor=#FFFFFF;fontColor=#4D3B00;fontSize=13;fontStyle=1;align=left;spacingLeft=10;collapsible=0;strokeWidth=1.5;fontFamily=Helvetica;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="60" y="573" width="400" height="201" as="geometry"/></mxCell>
<mxCell id="tqc16" value="Daily &lt;b&gt;02:30&lt;/b&gt;.&lt;br&gt;&lt;b&gt;Free scorers, every turn&lt;/b&gt;: language_match, has_citation, degraded_turn, used_fallback_model, first_token_s, first_token_in_budget, turn_cost_eur.&lt;br&gt;&lt;b&gt;LLM judges, on a sample&lt;/b&gt;: retrieval_groundedness, numeric_fidelity, honest_limits, off_topic_refusal, retrieval_sufficiency, relevance_to_query, retrieval_relevance.&lt;br&gt;Thumbs-down and degraded turns: always judged.&lt;br&gt;Token guard: estimate first, refuses above max_input_tokens." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="tqc15"><mxGeometry x="0" y="30" width="400" height="171" as="geometry"/></mxCell>
<mxCell id="tqe17" value="reads traces, writes verdicts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;strokeColor=#2E7D32;dashed=1;dashPattern=2 3;endArrow=open;endFill=0;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tqc4" target="tqc15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
