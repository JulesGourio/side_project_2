.playwright-mcp/

files_to_compare/
debug_images/
debug_results/
sql_data/
# utils/ : on versionne les .py (outils Databricks), on ignore les données générées
utils/*.json
utils/*.jsonl
utils/*.csv
utils/lakebase_export/
utils/temp_processed_files/
lakebase_export/

# Intraqual — données locales, ne pas versionner
