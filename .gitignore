target_config.env

# Generated typings (IDE stubs — not handwritten)
typings/

# Translator/ : ancien prototype, feature migrée vers le repo qualibot-translate
# (voir project_qualibot_translate_extraction.md). Dossier local non nettoyé
# (archivage encore à faire) — on continue d'ignorer ses gros artefacts
# générés/binaires (docx source/traduits, rapports HTML, workbench par job).
Translator/reports/
Translator/Sample Docs/
Translator/Translated/
Translator/workbench/
Translator/_inspect/
# Edge browser profile used by intraqual scraping (cache/cookies) - never commit
utils/deploy/.intraqual_profile/

# Source archive
*.zip

# Local MLflow output (tracking store and runs)
mlruns/
mlflow.db
