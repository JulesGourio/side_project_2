# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
dist/
build/
.ruff_cache/

# Node
client/node_modules/
client/.vite/
# Built at deployment (bun run build); the sync rules of databricks.yml and the deploy script include it.
client/out/

# Scratch export artifacts:
# reproducible, and too large for Databricks Apps' 10MB per-file deploy limit.
dev_to_uat_v2_export/
utils/dev_to_uat_v2_export/

# Local Intraqual scratch folders (copies of source documents, already on the UC volume), not app source.
intraqual_downloads_missing/
intraqual_missing_staged/

# Environment
.env.local
.env

# IDE
# .vscode/tasks.json ships with the repo (the everyday deploy task); settings.json is personal editor configuration
.vscode/settings.json
.idea/
.claude

# OS
.DS_Store
Thumbs.db

# Browser automation traces (snapshots, console dumps): local debugging artifacts only.
.playwright-mcp/

files_to_compare/
debug_images/
debug_results/
sql_data/
# utils/: the .py tools are versioned; generated data is ignored
utils/*.json
utils/*.jsonl
utils/*.csv
utils/lakebase_export/
utils/temp_processed_files/
lakebase_export/

# Local Intraqual data: not versioned
Intraqual_files/
intraqual_downloads/
intraqual_extracted/
scripts/.intraqual_profile/

# Local data and feedback
user_feedbacks/
test_prompt/

# Office files and archives
*.xlsx
*.xls
*.zip

# Office temp/lock files (Windows)
~$*

debug/

# Generated per-target env file written by
# deploy_qualibot.ps1 and uploaded to the workspace — not to be committed.
target_config.env

# Generated typings (IDE stubs — not handwritten)
typings/

# Translator/: local folder of another project; its generated artifacts and binaries are ignored
# (source and translated .docx files, HTML reports, per-job workbench).
Translator/reports/
Translator/Sample Docs/
Translator/Translated/
Translator/workbench/
Translator/_inspect/
# Edge browser profile used by intraqual scraping (cache/cookies) - never commit
utils/deploy/.intraqual_profile/

# Source archive
*.zip

# Local MLflow output (tracking store and runs)
mlruns/
mlflow.db
