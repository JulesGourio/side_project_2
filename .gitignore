# Données / feedbacks locaux
user_feedbacks/
test_prompt/

# Fichiers Office et archives
*.xlsx
*.xls
*.zip

# Office temp/lock files (Windows)
~$*

debug/

# Generated per-env vars (COMPARE_VOLUME_PATH, CHAT_ENDPOINT_*) written by
